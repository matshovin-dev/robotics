# Kompilerte filer og executables
*.o
*.out
*.exe
*.app
*.a
*.so
*.dylib

# Test executables (men behold test source)
test_*
!tests/test_*.c

# MacOS
.DS_Store
.AppleDouble
.LSOverride

# VS Code
.vscode/*
!.vscode/settings.json

# Build artifacts
build/
dist/
bin/

# Other
*.wav
*.mp3
*.mp4

# Temporary files
*.tmp
*.swp
*~
*.autosave
*.bak

# Python (hvis du later legger til Python scripts)
__pycache__/
*.pyc
*.pyo

# Documentation generated (Doxygen etc)
html/
latex/
docs/generated/

# SolidWorks files (large source files, backup separately)
assets/3d_models/solidworks/
*.SLDPRT
*.SLDASM
*.SLDDRW
*.SLDPRT~
*.SLDASM~
